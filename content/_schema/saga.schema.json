{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "saga.schema.json",
  "description": "content/saga.yaml: copy of the PayFlow board on /projects (spec 005 RD-08). The notes and the REVERSED explanation are audited wording.",
  "allOf": [{ "$ref": "common.schema.json#/definitions/shared" }],
  "type": "object",
  "required": ["board"],
  "definitions": {
    "text": { "$ref": "common.schema.json#/definitions/text" },
    "texts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "common.schema.json#/definitions/text" }
    }
  },
  "properties": {
    "id": true,
    "published": true,
    "featured": true,
    "order": true,
    "updated": true,
    "board": {
      "type": "object",
      "required": [
        "heading",
        "label",
        "lead",
        "notes",
        "reversed",
        "controls",
        "scenarios",
        "fields",
        "services",
        "status",
        "events"
      ],
      "properties": {
        "heading": { "$ref": "#/definitions/text" },
        "label": { "$ref": "#/definitions/text" },
        "lead": { "$ref": "#/definitions/text" },
        "reversed": { "$ref": "#/definitions/text" },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/text" }
        },
        "controls": {
          "type": "object",
          "required": ["scenario", "run", "pause", "resume"],
          "additionalProperties": { "$ref": "#/definitions/text" }
        },
        "scenarios": {
          "type": "object",
          "required": [
            "completes",
            "wallet-crash",
            "duplicate-delivery",
            "risk-rejection",
            "broker-outage",
            "insufficient-funds"
          ],
          "additionalProperties": { "$ref": "#/definitions/text" }
        },
        "fields": { "$ref": "#/definitions/texts" },
        "services": {
          "type": "object",
          "required": ["payment", "wallet", "risk", "broker"],
          "additionalProperties": { "$ref": "#/definitions/text" }
        },
        "status": {
          "type": "object",
          "required": ["idle", "running", "paused", "done"],
          "additionalProperties": { "$ref": "#/definitions/text" }
        },
        "events": {
          "type": "object",
          "required": [
            "PAYMENT_COMMITTED",
            "HTTP_202",
            "RELAY_PUBLISHED",
            "MESSAGE_APPLIED",
            "REPLY_IGNORED",
            "DUPLICATE_DROPPED",
            "COMMAND_RESENT",
            "BROKER_DOWN",
            "BROKER_UP",
            "WALLET_DOWN",
            "WALLET_UP"
          ],
          "additionalProperties": { "$ref": "#/definitions/text" }
        }
      }
    }
  }
}
