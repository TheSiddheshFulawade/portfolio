{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "description": "Front matter of content/projects/<id>.md. The file name must equal the id.",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/shared"
    }
  ],
  "type": "object",
  "required": ["order", "title", "tagline", "status", "stack"],
  "properties": {
    "id": true,
    "published": true,
    "featured": true,
    "order": true,
    "updated": true,
    "title": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "tagline": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "status": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "stack": {
      "$ref": "common.schema.json#/definitions/stringList"
    },
    "earlier": {
      "type": "boolean",
      "description": "Shown under Earlier work, without a repo link"
    },
    "repo": {
      "$ref": "common.schema.json#/definitions/url"
    },
    "phase": {
      "enum": ["in-development", "released"],
      "description": "Release state; in-development needs proven and planned (REQ-ACC-005)"
    },
    "proven": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/definitions/text"
      },
      "description": "What merged tests prove"
    },
    "planned": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/definitions/text"
      },
      "description": "What is designed but not built or not proven yet"
    }
  },
  "additionalProperties": false,
  "if": {
    "required": ["phase"],
    "properties": {
      "phase": {
        "const": "in-development"
      }
    }
  },
  "then": {
    "required": ["proven", "planned"]
  }
}
