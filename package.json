{
  "name": "portfolio",
  "private": true,
  "description": "Root script contract (spec 001, REQ-REPO-002; web only since ADR-0004). Scripts only: no dependencies, no workspaces, no lockfile.",
  "scripts": {
    "install:web": "npm --prefix apps/web ci",
    "lint:web": "npm --prefix apps/web run lint",
    "format:check:web": "npm --prefix apps/web run format:check",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test:web": "npm --prefix apps/web run test",
    "build:web": "npm --prefix apps/web run build",
    "audit:web": "npm --prefix apps/web audit --omit=dev --audit-level=high",
    "format:web": "npm --prefix apps/web run format",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\" \"apps/web/scripts/**/*.test.mjs\"",
    "check:repo": "node scripts/check-repo.mjs",
    "lint": "npm run lint:web",
    "format:check": "npm run format:check:web",
    "typecheck": "npm run typecheck:web",
    "test": "npm run test:web",
    "build": "npm run build:web",
    "audit": "npm run audit:web",
    "verify": "npm run check:repo && npm run test:hooks && npm run test:scripts && npm run lint && npm run typecheck && npm run test && npm run test:functions:web && npm run build && npm run audit",
    "test:functions:web": "npm --prefix apps/web run test:functions"
  }
}
