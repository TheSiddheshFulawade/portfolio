{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx playwright *)",
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(node .claude/hooks/*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(gh *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(winget *)",
      "Bash(choco *)",
      "Bash(scoop *)",
      "Bash(setx *)",
      "Bash(reg *)",
      "Bash(schtasks *)",
      "Bash(shutdown *)",
      "Edit(.claude/hooks/**)",
      "Edit(.mcp.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env*)",
      "Edit(**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.m2/settings*.xml)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/_netrc)",
      "Read(~/.claude/.credentials.json)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.jks)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.npmrc)",
      "Edit(~/.claude/settings.json)",
      "Bash(gh auth token*)",
      "Bash(git credential *)",
      "Bash(git clean -x*)",
      "Bash(git clean -fdx*)",
      "Bash(git clean -fx*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/spec-status.mjs" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-bash.mjs" }]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/protect-secrets.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/quality-gate.mjs", "timeout": 300 }]
      }
    ]
  }
}
