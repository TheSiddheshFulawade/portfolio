{
  "name": "web",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "scripts": {
    "ng": "ng",
    "predev": "node scripts/build-content.mjs",
    "dev": "ng serve",
    "prebuild": "node scripts/build-content.mjs",
    "build": "ng build",
    "pretest": "node scripts/build-content.mjs",
    "test": "ng test --no-watch --coverage",
    "pretypecheck": "node scripts/build-content.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.server.json",
    "e2e": "playwright test",
    "lint": "ng lint && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postbuild": "node scripts/inline-critical.mjs && node scripts/emit-404.mjs && node scripts/emit-headers.mjs && node scripts/verify-prerender.mjs && node scripts/verify-bundle.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "og-image": "node scripts/og-image.mjs",
    "test:functions": "node --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/ssr": "22.2.7",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "angular-eslint": "22.7.0",
    "eslint": "10.15.0",
    "jsdom": "30.1.3",
    "marked": "18.1.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
